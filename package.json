{
  "name": "quence-tn",
  "version": "0.1.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node server.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "build:electron": "tsc -p electron/tsconfig.json",
    "electron:dev": "concurrently --kill-others \"npm run dev\" \"wait-on tcp:3000 && npm run build:electron && electron .\"",
    "rebuild": "electron-rebuild -f -w node-pty",
    "electron:build": "npm run build && npm run build:electron && electron-builder",
    "build:electron-win": "npm run build && npm run build:electron && electron-builder --win --publish never",
    "build:electron-mac": "npm run rebuild && npm run build && npm run build:electron && electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.quence.tn",
    "productName": "QuenceTN",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "Marijanoo",
      "repo": "quence-tn"
    },
    "files": [
      "dist-electron/**/*",
      "out/**/*",
      "package.json",
      "public/logo.png",
      "public/logo.ico",
      "public/logo.icns",
      "node_modules/node-pty/**/*",
      "node_modules/pidusage/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/pidusage/**/*"
    ],
    "mac": {
      "icon": "public/logo.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ]
    },
    "win": {
      "icon": "public/logo.ico",
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "differentialPackage": true
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-serve": "^1.1.0",
    "electron-updater": "^6.8.3",
    "lucide-react": "^0.564.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "node-pty": "^1.1.0",
    "pidusage": "^4.0.1",
    "react": "^19",
    "react-dom": "^19",
    "sonner": "^1.7.1",
    "tailwind-merge": "^3.3.1",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "electron": "^34.5.8",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "1.3.3",
    "typescript": "^5.7.3",
    "wait-on": "^9.0.10"
  }
}
